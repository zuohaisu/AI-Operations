# Copy this file to `.env` (gitignored) and fill in YOUR key.
# All three providers below are OpenAI-compatible — only the base URL + model differ.
# The orchestrator appends /chat/completions to XY_LLM_BASE_URL, so give the VERSIONED base.

# ---- DeepSeek (recommended: strong code model, cheap) ----
XY_LLM_BASE_URL=https://api.deepseek.com/v1
XY_LLM_API_KEY=sk-xxxx
XY_LLM_MODEL=deepseek-chat
# for reasoning: XY_LLM_MODEL=deepseek-reasoner

# ---- GLM / Zhipu ----
# XY_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# XY_LLM_API_KEY=xxxx
# XY_LLM_MODEL=glm-4-plus

# ---- Kimi / Moonshot ----
# XY_LLM_BASE_URL=https://api.moonshot.cn/v1
# XY_LLM_API_KEY=xxxxx
# XY_LLM_MODEL=moonshot-v1-32k
