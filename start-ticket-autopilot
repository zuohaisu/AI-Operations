#!/bin/sh
# Start the local Ticket Autopilot settings service without a global install.
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VENV="$ROOT_DIR/.venv"
COMMAND=${1:-start}

case "$COMMAND" in
  start|status|stop|restart) ;;
  *)
    echo "Usage: ./start-ticket-autopilot [start|status|stop|restart]" >&2
    exit 2
    ;;
esac

valid_python() {
  "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null
}

# Prefer a working project environment even when macOS's `python3` is older.
if [ -x "$VENV/bin/python" ] && valid_python "$VENV/bin/python"; then
  :
else
  rm -rf "$VENV"
  CREATE_PYTHON=""
  for candidate in "${PYTHON_BIN:-}" python3.13 python3.12 python3.11 python3; do
    [ -n "$candidate" ] || continue
    if command -v "$candidate" >/dev/null 2>&1 && valid_python "$candidate"; then
      CREATE_PYTHON=$candidate
      break
    fi
  done
  if [ -z "$CREATE_PYTHON" ]; then
    echo "Ticket Autopilot requires Python 3.11 or newer. Install Python 3.11+ and run again." >&2
    exit 1
  fi
  if ! "$CREATE_PYTHON" -m venv "$VENV"; then
    echo "Could not create .venv. Check that Python 3.11+ includes venv support." >&2
    exit 1
  fi
fi

if ! "$VENV/bin/python" -m pip --version >/dev/null 2>&1; then
  if ! "$VENV/bin/python" -m ensurepip --upgrade >/dev/null 2>&1; then
    echo "Could not repair pip in .venv. Recreate .venv with a Python that includes ensurepip." >&2
    exit 1
  fi
fi

# Editable installation gives the detached interpreter the current project
# without requiring activation or a globally installed command.
if ! "$VENV/bin/python" -m pip install --disable-pip-version-check --quiet --editable "$ROOT_DIR"; then
  echo "Could not install Ticket Autopilot into .venv. Check local pip permissions and try again." >&2
  exit 1
fi

export TICKET_AUTOPILOT_PROJECT_ROOT="$ROOT_DIR"
exec "$VENV/bin/python" -m ticket_autopilot.web "$COMMAND"
