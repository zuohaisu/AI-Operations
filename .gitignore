# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
*.swp
*.swo
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
.next/
.turbo/

# Logs
*.log

# Local temp / scratch
tmp/
scratch/
*.bak

# Ticket Autopilot runtime artifacts (spec §12.4)
.ticket-autopilot/
runs/
worktrees/

# Secrets / credentials (never commit)
.env
*.local

# Engine sandbox (strict cwd for the cli executor) — keep .gitkeep
sandbox/*
!sandbox/.gitkeep
