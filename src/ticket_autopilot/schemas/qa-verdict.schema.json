{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "qa-verdict",
  "description": "QA agent verdict contract (Ticket Autopilot spec §9.1). Any payload that fails this schema must never be treated as PASS (§2.4).",
  "type": "object",
  "required": [
    "schema_version",
    "issue_key",
    "run_id",
    "qa_attempt",
    "verdict",
    "acceptance_criteria",
    "findings",
    "non_blocking_comments",
    "recommended_next_state"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "issue_key": {"type": "string"},
    "run_id": {"type": "string"},
    "qa_attempt": {"type": "integer"},
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "type", "acceptance_criterion_id", "summary", "evidence", "required_fix"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["blocker", "major", "minor"]},
          "type": {"type": "string"},
          "acceptance_criterion_id": {"type": "string"},
          "summary": {"type": "string"},
          "evidence": {"type": "object"},
          "required_fix": {"type": "string"}
        }
      }
    },
    "non_blocking_comments": {"type": "array"},
    "recommended_next_state": {"type": "string"}
  }
}
