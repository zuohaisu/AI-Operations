{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "development-evidence",
  "description": "Immutable deterministic development-verification evidence for independent QA consumption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "run", "status", "verified", "eligible_for_pr",
    "decision_inputs", "git", "scope", "requested_checks", "checks", "commands",
    "evidence_gaps", "completed_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "kind": {"type": "string", "enum": ["ticket-autopilot.development-evidence"]},
    "status": {"type": "string", "enum": ["VERIFIED", "FAILED_DEVELOPMENT", "BLOCKED_ENVIRONMENT", "BLOCKED_NEEDS_HUMAN", "BLOCKED_REQUIREMENTS"]},
    "verified": {"type": "boolean"},
    "eligible_for_pr": {"type": "boolean"},
    "decision_inputs": {"type": "array", "items": {"type": "string"}},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "issue_key", "repository", "artifact_dir", "worktree", "branch", "base_sha", "attempt"],
      "properties": {
        "run_id": {"type": "string"}, "issue_key": {"type": "string"},
        "repository": {"type": "string"}, "artifact_dir": {"type": "string"},
        "worktree": {"type": "string"}, "branch": {"type": "string"},
        "base_sha": {"type": "string"}, "attempt": {"type": "integer"}
      }
    },
    "git": {"type": "object"},
    "scope": {"type": "object"},
    "requested_checks": {"type": "array", "items": {"type": "string"}},
    "checks": {"type": "array", "items": {"$ref": "#/definitions/command"}},
    "commands": {"type": "array", "items": {"$ref": "#/definitions/command"}},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}},
    "completed_at": {"type": "string", "minLength": 1}
  },
  "definitions": {
    "command": {
      "type": "object",
      "required": ["id", "source", "command", "argv", "cwd", "timeout_seconds", "started_at", "finished_at", "exit_code", "stdout", "stderr", "timed_out"],
      "properties": {
        "id": {"type": "string"}, "source": {"type": "string"}, "command": {"type": "string"},
        "argv": {"type": "array", "items": {"type": "string"}}, "cwd": {"type": "string"},
        "timeout_seconds": {"type": "integer", "minimum": 1}, "started_at": {"type": "string"},
        "finished_at": {"type": "string"}, "exit_code": {"type": ["integer", "null"]},
        "stdout": {"type": "string"}, "stderr": {"type": "string"}, "timed_out": {"type": "boolean"},
        "acceptance_criterion_id": {"type": "string"}
      }
    }
  }
}
