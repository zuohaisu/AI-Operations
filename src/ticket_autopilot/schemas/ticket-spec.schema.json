{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ticket-spec",
  "description": "Versioned, traceable input contract mechanically mapped from a Plane issue. It must validate before any Agent invocation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_key",
    "source_issue",
    "goal",
    "scope",
    "out_of_scope",
    "risk_tier",
    "acceptance_criteria",
    "verification",
    "repository",
    "required_checks",
    "constraints",
    "provenance"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "issue_key": {"type": "string", "minLength": 1},
    "source_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id", "key", "title", "description"],
      "properties": {
        "provider": {"type": "string", "enum": ["plane"]},
        "id": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "goal": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "out_of_scope": {"type": "string", "minLength": 1},
    "risk_tier": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-[1-9][0-9]*$"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_criterion_id", "type", "command"],
        "properties": {
          "acceptance_criterion_id": {"type": "string", "pattern": "^AC-[1-9][0-9]*$"},
          "type": {"type": "string", "enum": ["automated", "query", "inspection", "manual"]},
          "command": {"type": "string", "minLength": 1}
        }
      }
    },
    "repository": {"type": "string", "minLength": 1},
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_fix_attempts", "allow_main_push"],
      "properties": {
        "max_fix_attempts": {"type": "integer", "minimum": 0},
        "allow_main_push": {"type": "boolean", "enum": [false]},
        "forbidden_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "max_changed_files": {"type": "integer", "minimum": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal", "scope", "out_of_scope", "risk_tier", "acceptance_criteria",
        "verification", "repository", "required_checks", "constraints"
      ],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "out_of_scope": {"type": "string", "minLength": 1},
        "risk_tier": {"type": "string", "minLength": 1},
        "acceptance_criteria": {"type": "string", "minLength": 1},
        "verification": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "required_checks": {"type": "string", "minLength": 1},
        "constraints": {"type": "string", "minLength": 1}
      }
    }
  }
}
